# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Local editor/agent configuration and generated hooks.
.cursor/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Beads gate locks are runtime state, machine-local like the locks bd already
# ignores inside .beads/ — transient, never committed.
*.gate.lock

node_modules/
.nx/
# Next.js build output, including the standalone server tree.
.next/
# Generated by the Next build, regenerated on every build, and it references
# paths inside .next/. The file itself says it must not be edited.
apps/genie/next-env.d.ts
# S0-05 throwaway composition probe. Temporary, removed once the retained tests
# cover startup ordering, failure termination, context sharing, redirects and
# packaging. Never source.
.spike/
dist/
coverage/
.vitest/
*.tsbuildinfo

# Storybook host: the static build output, generated and never committed.
storybook-static/

# Playwright output: per-test trace and screenshot directories, plus the HTML
# report. Written on every run, never source, and `--check` must not read them.
test-results/
playwright-report/

# Coverage tool scratch space. Holds request and snapshot JSON, never source.
.supercov/

# Generated at build time from MODULE_INCLUDE. Never commit it (ADR 0008).
apps/genie/src/modules.ts

.env
.env.*
!.env.example
