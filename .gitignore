# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Beads gate locks are runtime state, machine-local like the locks bd already
# ignores inside .beads/ — transient, never committed.
*.gate.lock

node_modules/
.nx/
dist/
coverage/
*.tsbuildinfo

# Agent scratch space. Holds the execution ledger and review packages, never source.
.superpowers/

# Generated at build time from MODULE_INCLUDE. Never commit it (ADR 0008).
apps/genie/src/modules.ts

.env
.env.*
!.env.example
