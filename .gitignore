# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Beads gate locks are runtime state, machine-local like the locks bd already
# ignores inside .beads/ — transient, never committed.
*.gate.lock
