{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "shadcn": {
      "type": "local",
      "command": [
        "sh",
        "-c",
        "cd \"$(git rev-parse --show-toplevel)/packages/ui\" && exec npx -y shadcn@4.22.1 mcp"
      ],
      "enabled": true
    },
    "nx-mcp": {
      "type": "local",
      "command": ["npx", "nx", "mcp"],
      "enabled": true
    }
  }
}
