{
  "_meta": {
    "models": {
      "auditEvent": "An append-only record of who did what, when, on which target, with a summary and structured metadata. Kept for the tenant's lifetime. Actor is null for system events.",
      "auditFilterOptions": "The actors, action keys, and target types that appear in this tenant, used to fill the filter selects.",
      "tenantSettings": "One row per tenant for the non-branding settings the administrator owns: onboarding mode, local accounts, session idle minutes.",
      "realm": "What the tenant's Keycloak realm supports; brokered-only realms cannot enable local accounts.",
      "moduleConfig": "Per-tenant configuration of one entitled module: the schema converted from the module's zod object (five field kinds, DEC-28) plus the stored values.",
      "viewer": "The signed-in administrator with permission keys and time zone.",
      "category": "A core category row (id, name, position) that groups navigation entries across modules (DEC-51). Counts are server-derived: solutions from solution_category, modules from tenant_module.category_id.",
      "module": "One module compiled into the image with its tenant_module row: enabled, category_id, the <id>:use key, the seeded <Display name> user role, and who holds a role carrying that key, read from role_assignment (DEC-50)."
    },
    "relationships": [
      "auditEvent.actor is a person (or null for System); erased people appear anonymized",
      "auditEvent target is referenced by type and id; targetExists is false when the record was removed",
      "moduleConfig belongs to one entitled module; Solutions declares no schema and has no card (DEC-30)",
      "module.categoryId references a category or is null; the picker shows for every module with a static workspace entry, the solutions hub included (DEC-50)",
      "module.holders is read only here; role assignment happens on the Roles screen (DEC-39)",
      "category ids match the solutions section data so both trees show the same headings"
    ]
  },
