      "module": "A module that declares permission keys and record types for scopes, with the tenant's entitlement state.",
      "scopeRecord": "A record a module exposes for scoped assignments, for example one chat solution.",
      "session": "An active browser session of a person.",
      "tenantSettings": "The settings that change these screens: onboarding mode and local accounts.",
      "currentUserId": "The signed-in administrator. Their own row cannot be disabled, removed, or stripped of roles."
    },
    "relationships": [
      "person has many groups through membership, each membership carrying its source (idp or local)",
      "group has many persons",
      "role has many roleAssignments; each roleAssignment points at one person or one group and optionally at one scopeRecord",
      "module declares permissionKeys and recordTypes; role permissions reference module permission keys; scopeRecord belongs to a module record type",
      "person has many sessions"
    ]
  },
