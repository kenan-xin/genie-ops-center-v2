{
  "name": "@genie/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#hooks/*": "./src/hooks/*.ts",
    "#lib/*": "./src/lib/*.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/theme/tokens.ts",
    "./fonts.css": "./src/fonts/fonts.css",
    "./fonts/*": "./src/fonts/*"
  },
  "scripts": {
    "lint": "oxlint --config ../../oxlint.config.ts src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8"
  },
  "devDependencies": {
    "@genie/config": "workspace:*",
    "@storybook/nextjs-vite": "10.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxlint": "1.89.0",
    "storybook": "10.6.3",
    "vitest": "5.0.5"
  },
  "nx": {
    "tags": [
      "ui"
    ]
  }
}
