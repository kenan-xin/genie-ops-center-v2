{
  "name": "@genie/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./errors": "./src/lib/errors/index.ts",
    "./features/audit": "./src/features/audit/index.ts",
    "./security": "./src/lib/content-security-policy/index.ts",
    "./testing": "./testing/index.ts",
    "./testing/stage-workspace": "./testing/stage-workspace.ts",
    "./testing/required-tests-runner": "./testing/required-tests-runner.ts",
    "./testing/required-tests-validator": "./testing/required-tests-validator.ts",
    "./contracts": "./contracts/index.ts",
    "./tenant-config": "./src/lib/tenant-config/index.ts"
  },
  "scripts": {
    "lint": "oxlint --config ../../oxlint.config.ts src contracts testing tools",
    "schemas": "node tools/emit-schemas.ts",
    "test": "vitest run",
    "test:integration": "node tools/run-required-tests.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.browser.json"
  },
  "dependencies": {
    "@genie/ui": "workspace:*",
    "@react-email/components": "1.0.12",
    "@trpc/server": "11.19.0",
    "better-auth": "1.7.6",
    "dompurify": "3.4.16",
    "drizzle-orm": "0.45.2",
    "es-toolkit": "1.52.0",
    "jsdom": "30.1.1",
    "nodemailer": "7.0.13",
    "pg": "8.23.0",
    "pg-boss": "12.33.5",
    "pino": "10.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.28.1",
    "uuid": "14.0.2",
    "yaml": "2.9.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@genie/config": "workspace:*",
    "@storybook/nextjs-vite": "10.6.0",
    "@testcontainers/postgresql": "12.1.0",
    "@types/jsdom": "30.0.0",
    "@types/nodemailer": "7.0.12",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "oxlint": "1.83.0",
    "storybook": "10.6.0",
    "testcontainers": "12.1.0",
    "vitest": "4.1.11"
  },
  "nx": {
    "tags": [
      "core"
    ],
    "targets": {
      "schemas": {
        "cache": false,
        "outputs": [
          "{workspaceRoot}/deploy/schemas"
        ]
      }
    }
  }
}
