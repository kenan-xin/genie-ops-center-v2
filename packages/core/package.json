{
  "name": "@genie/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./errors": "./src/lib/errors/index.ts",
    "./features/account": "./src/features/account/index.ts",
    "./features/agent": "./src/features/agent/index.ts",
    "./features/audit": "./src/features/audit/index.ts",
    "./features/branding": "./src/features/branding/index.ts",
    "./features/break-glass": "./src/features/break-glass/index.ts",
    "./features/categories": "./src/features/categories/index.ts",
    "./features/groups": "./src/features/groups/index.ts",
    "./features/modules": "./src/features/modules/index.ts",
    "./features/people": "./src/features/people/index.ts",
    "./features/roles": "./src/features/roles/index.ts",
    "./features/settings": "./src/features/settings/index.ts",
    "./features/shell": "./src/features/shell/index.ts",
    "./features/sign-in": "./src/features/sign-in/index.ts",
    "./logging": "./src/services/logging/index.ts",
    "./rpc": "./src/lib/rpc/index.ts",
    "./rpc/client": "./src/lib/rpc/module-client.tsx",
    "./security": "./src/lib/content-security-policy/index.ts",
    "./testing": "./testing/index.ts",
    "./testing/stage-workspace": "./testing/stage-workspace.ts",
    "./testing/model-transports": "./testing/model-transports.ts",
    "./testing/required-tests-runner": "./testing/required-tests-runner.ts",
    "./testing/required-tests-validator": "./testing/required-tests-validator.ts",
    "./contracts": "./contracts/index.ts",
    "./tenant-config": "./src/lib/tenant-config/index.ts"
  },
  "scripts": {
    "lint": "oxlint --config ../../oxlint.config.ts src contracts testing tools",
    "agent-prompt": "node tools/emit-agent-prompt.ts && oxfmt src/services/agent/catalog-prompt.generated.ts",
    "schemas": "node tools/emit-schemas.ts",
    "test": "vitest run",
    "test:integration": "node tools/run-required-tests.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.browser.json"
  },
  "dependencies": {
    "@genie/ui": "workspace:*",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@opentelemetry/api": "1.10.0",
    "@openuidev/react-lang": "1.0.2",
    "@orpc/contract": "catalog:",
    "@orpc/server": "catalog:",
    "@react-email/components": "1.0.12",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-pacer": "0.24.1",
    "@tanstack/react-query": "5.104.5",
    "ai": "7.0.154",
    "better-auth": "1.7.12",
    "dompurify": "3.4.17",
    "drizzle-orm": "0.45.4",
    "es-toolkit": "1.52.0",
    "jsdom": "30.1.3",
    "lucide-react": "1.61.0",
    "nodemailer": "10.1.7",
    "pg": "catalog:",
    "pg-boss": "12.38.0",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-idle-timer": "5.7.3",
    "resend": "6.34.1",
    "uuid": "14.0.3",
    "yaml": "2.9.1",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@genie/config": "workspace:*",
    "@storybook/nextjs-vite": "10.6.3",
    "@testcontainers/postgresql": "12.2.1",
    "@types/jsdom": "30.0.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "oxlint": "1.89.0",
    "storybook": "10.6.3",
    "testcontainers": "12.2.1",
    "vitest": "5.0.5"
  },
  "nx": {
    "tags": [
      "core"
    ],
    "targets": {
      "schemas": {
        "cache": false,
        "outputs": [
          "{workspaceRoot}/deploy/schemas"
        ]
      }
    }
  }
}
