{
  "name": "hello-chat-default-stream",
  "request": {
    "method": "POST",
    "url": "https://openrouter.ai/api/v1/chat/completions",
    "body": {
      "model": "openai/gpt-6.1-terra",
      "messages": [{ "role": "user", "content": "Say hello." }],
      "provider": { "data_collection": "deny" },
      "stream": true,
      "stream_options": { "include_usage": true }
    }
  },
  "response": {
    "status": 200,
    "events": [
      {
        "id": "gen-recorded-chat-default-stream",
        "model": "openai/gpt-6.1-terra",
        "choices": [
          { "index": 0, "delta": { "role": "assistant", "content": "Hel" } }
        ]
      },
      {
        "id": "gen-recorded-chat-default-stream",
        "model": "openai/gpt-6.1-terra",
        "choices": [
          {
            "index": 0,
            "delta": {
              "role": "assistant",
              "content": "lo from the recording."
            },
            "finish_reason": "stop"
          }
        ],
        "usage": {
          "prompt_tokens": 10,
          "completion_tokens": 5,
          "total_tokens": 15
        }
      }
    ]
  }
}
