{
  "hooks": {
    "PostCompact": [
      {
        "hooks": [
          {
            "command": "bd codex-hook PostCompact",
            "statusMessage": "Scheduling Beads context refresh",
            "type": "command"
          }
        ],
        "matcher": "manual|auto"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "tool=\"${IMPECCABLE_BIN:-$(command -v impeccable 2>/dev/null)}\"; [ -x \"$tool\" ] || exit 0; \"$tool\" hook",
            "commandWindows": "if defined IMPECCABLE_BIN (if exist \"%IMPECCABLE_BIN%\" (\"%IMPECCABLE_BIN%\" hook)) else (where impeccable.cmd >nul 2>nul && impeccable.cmd hook)",
            "statusMessage": "Checking UI changes",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|apply_patch"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "bd codex-hook PreCompact",
            "statusMessage": "Checking Beads context",
            "type": "command"
          }
        ],
        "matcher": "manual|auto"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd codex-hook SessionStart",
            "statusMessage": "Loading Beads context",
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "tool=\"${IMPECCABLE_BIN:-$(command -v impeccable 2>/dev/null)}\"; [ -x \"$tool\" ] || exit 0; \"$tool\" hook",
            "commandWindows": "if defined IMPECCABLE_BIN (if exist \"%IMPECCABLE_BIN%\" (\"%IMPECCABLE_BIN%\" hook)) else (where impeccable.cmd >nul 2>nul && impeccable.cmd hook)",
            "statusMessage": "Design deep pass",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "bd codex-hook UserPromptSubmit",
            "statusMessage": "Refreshing Beads context",
            "type": "command"
          }
        ]
      }
    ]
  }
}
