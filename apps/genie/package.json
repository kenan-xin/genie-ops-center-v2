{
  "name": "@genie/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/check-registry.ts && next build && node tools/prune-public-migration-sql.mjs",
    "build-image": "docker build -f ../../deploy/Dockerfile --build-arg MODULE_INCLUDE=${MODULE_INCLUDE-placeholder} -t genie-s005:test ../..",
    "build-fixture-image": "node tools/build-fixture-image.ts",
    "generate-registry": "node tools/generate-registry.ts",
    "start": "node tools/start-standalone.mjs",
    "lint": "oxlint --config ../../oxlint.config.ts src testing tools e2e *.config.ts *.config.mjs",
    "test": "vitest run",
    "test:integration": "node tools/run-required-tests.ts",
    "test:e2e:fixture": "playwright test --config playwright.fixture.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@genie/core": "workspace:*",
    "@genie/module-placeholder": "workspace:*",
    "@genie/ui": "workspace:*",
    "@trpc/server": "11.19.0",
    "next": "16.3.5",
    "next-intl": "4.14.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@genie/config": "workspace:*",
    "@genie/generators": "workspace:*",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@trpc/client": "11.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxlint": "1.83.0",
    "tailwindcss": "4.3.3",
    "vitest": "4.1.11"
  },
  "nx": {
    "tags": [
      "app"
    ],
    "targets": {
      "generate-registry": {
        "cache": true,
        "inputs": [
          "production",
          "^production",
          {
            "runtime": "node tools/generators/src/selection/print.ts"
          }
        ],
        "outputs": [
          "{projectRoot}/src/modules.ts"
        ]
      },
      "build": {
        "dependsOn": [
          "generate-registry",
          "^build"
        ],
        "inputs": [
          "production",
          "^production",
          {
            "runtime": "node tools/generators/src/selection/print.ts"
          }
        ],
        "outputs": [
          "{projectRoot}/.next",
          "!{projectRoot}/.next/cache"
        ]
      },
      "build-image": {
        "cache": false,
        "dependsOn": [
          "build"
        ]
      },
      "typecheck": {
        "dependsOn": [
          "generate-registry",
          "^build"
        ],
        "inputs": [
          "default",
          "^production",
          {
            "runtime": "node tools/generators/src/selection/print.ts"
          }
        ]
      },
      "test": {
        "dependsOn": [
          "generate-registry"
        ],
        "inputs": [
          "default",
          "^production",
          {
            "runtime": "node tools/generators/src/selection/print.ts"
          }
        ]
      },
      "test:integration": {
        "dependsOn": [
          "build",
          "build-image",
          "test:e2e:fixture"
        ]
      },
      "build-fixture-image": {
        "cache": false
      },
      "test:e2e:fixture": {
        "cache": false,
        "dependsOn": [
          "build-fixture-image"
        ]
      }
    }
  }
}
