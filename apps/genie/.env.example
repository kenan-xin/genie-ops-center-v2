# Local development settings for `pnpm nx run @genie/app:dev`. Copy this file to
# apps/genie/.env.development.local, then fill in the two secrets at the bottom. Never commit a
# filled copy. Every other variable the image can read has a default;
# docs/architecture/environment-contract.md lists them all.
#
# Not .env.local: Nx loads a project's .env.local into every task it runs, so the integration and
# end-to-end tests would get these values and point their own Docker stacks at this database and
# sso.001.gs. `next dev` reads .env.development.local, and Nx loads it only for a target with a
# "development" configuration, which this project does not define.

# Where the app finds its one database. This is the local database from
# deploy/stack/compose.dev.yaml; user, password and database name are all `genie`, a local
# throwaway credential.
DATABASE_URL=postgres://genie:genie@127.0.0.1:5433/genie

# The one address people use to reach the app. Sign-in callbacks, cookies and email links are
# built from it. The genie-dev realm accepts only this address after sign-in, so keep it.
PUBLIC_URL=http://localhost:3000

# The Keycloak server that signs people in, and the realm on it that belongs to this deployment.
# Every developer shares the genie-dev realm on sso.001.gs.
KEYCLOAK_URL=https://sso.001.gs
KEYCLOAK_REALM=genie-dev

# The realm's client that the app signs in through. The realm template names it
# genie-ops-center.
KEYCLOAK_CLIENT_ID=genie-ops-center

# --- Secrets: ask the project owner for both values. ---

# Signs session cookies and encrypts the sign-in tokens stored in the database. It must be the
# secret of the database dump you restore, or existing sessions and tokens cannot be read.
BETTER_AUTH_SECRET=

# The password of the genie-ops-center client above. Keycloak checks it when the app exchanges a
# sign-in code for tokens.
KEYCLOAK_CLIENT_SECRET=

# Optional. The secret of the realm's genie-admin service client. Only Add person with local
# accounts and the identity-provider commands use it; leave it empty otherwise.
KEYCLOAK_ADMIN_CLIENT_SECRET=
