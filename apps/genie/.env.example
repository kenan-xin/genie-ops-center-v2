# Copy to apps/genie/.env.local for `pnpm nx run @genie/app:dev`. Git ignores .env.local; never
# commit a filled copy. docs/architecture/environment-contract.md lists every variable and default.

# The database from deploy/stack/compose.dev.yaml (a local throwaway credential).
DATABASE_URL=postgres://genie:genie@127.0.0.1:5433/genie

# The genie-dev realm accepts only this address as the return address after sign-in.
PUBLIC_URL=http://localhost:3000
PORT=3000

# The shared genie-dev realm on sso.001.gs.
KEYCLOAK_URL=https://sso.001.gs
KEYCLOAK_REALM=genie-dev
KEYCLOAK_CLIENT_ID=genie-ops-center

# Secrets: ask the project owner. BETTER_AUTH_SECRET must be the one of the database dump you
# restore, because stored tokens are encrypted with it.
BETTER_AUTH_SECRET=
KEYCLOAK_CLIENT_SECRET=
# Optional: only Add person with local accounts uses it.
KEYCLOAK_ADMIN_CLIENT_SECRET=
