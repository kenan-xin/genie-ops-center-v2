{
  "name": "@genie/storybook",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint --config ../../oxlint.config.ts .storybook stories testing",
    "test": "vitest run --project=unit",
    "test:selection-matrix": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@genie/ui": "workspace:*"
  },
  "devDependencies": {
    "@genie/config": "workspace:*",
    "@genie/core": "workspace:*",
    "@genie/generators": "workspace:*",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/addon-mcp": "10.6.3",
    "@storybook/addon-vitest": "10.6.3",
    "@storybook/nextjs-vite": "10.6.3",
    "@tailwindcss/vite": "4.3.3",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "next": "16.4.2",
    "oxlint": "1.89.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "nx": {
    "targets": {
      "storybook": {
        "dependsOn": [
          {
            "projects": [
              "@genie/app"
            ],
            "target": "generate-registry"
          }
        ],
        "options": {
          "args": "--host=127.0.0.1 --port=6006 --no-open"
        }
      },
      "build-storybook": {
        "dependsOn": [
          {
            "projects": [
              "@genie/app"
            ],
            "target": "generate-registry"
          }
        ]
      },
      "test-storybook": {
        "dependsOn": [
          {
            "projects": [
              "@genie/app"
            ],
            "target": "generate-registry"
          }
        ],
        "options": {
          "command": "node testing/test-storybook.ts"
        }
      },
      "test:selection-matrix": {
        "cache": true,
        "inputs": [
          "default",
          "{workspaceRoot}/packages/*/package.json",
          "{workspaceRoot}/packages/*/tsconfig*.json",
          "{workspaceRoot}/packages/config/src/storybook/**/*",
          "{workspaceRoot}/packages/config/src/typescript/**/*",
          "{workspaceRoot}/packages/config/src/vitest/**/*",
          "{workspaceRoot}/packages/core/testing/stage-workspace.ts",
          "{workspaceRoot}/packages/core/src/lib/errors/index.ts",
          "{workspaceRoot}/packages/ui/src/disclosure/disclosure.stories.tsx",
          "{workspaceRoot}/packages/modules/*/package.json",
          "{workspaceRoot}/packages/modules/*/tsconfig.json",
          "{workspaceRoot}/packages/modules/*/src/**/*",
          "{workspaceRoot}/tools/generators/**/*",
          "{workspaceRoot}/apps/genie/package.json",
          "{workspaceRoot}/apps/genie/tools/**/*",
          "{workspaceRoot}/package.json",
          "{workspaceRoot}/pnpm-workspace.yaml"
        ]
      }
    },
    "tags": [
      "app"
    ]
  }
}
