{
  "name": "@genie/storybook",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint --config ../../oxlint.config.ts .storybook testing",
    "test": "vitest run --project=unit",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@genie/core": "workspace:*",
    "@genie/ui": "workspace:*"
  },
  "devDependencies": {
    "@genie/config": "workspace:*",
    "@genie/generators": "workspace:*",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-mcp": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/nextjs-vite": "10.6.0",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "next": "16.3.5",
    "oxlint": "1.83.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "10.6.0",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  },
  "nx": {
    "targets": {
      "storybook": {
        "options": {
          "args": "--host=127.0.0.1 --port=6006 --no-open"
        }
      },
      "test-storybook": {
        "options": {
          "command": "vitest run --project=storybook --passWithNoTests=false"
        }
      }
    },
    "tags": [
      "app"
    ]
  }
}
